# Copy to backend/.env and fill in. Providers turn on automatically when their key/URL is set.
# Lists are comma-separated. Only models listed here can be called (the allowlist).

# --- App ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Used when a request doesn't name a model. Falls back to the first available model.
DEFAULT_MODEL=anthropic/claude-opus-5-5
REQUEST_TIMEOUT_S=120
MAX_RETRIES=2

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
# Reasoning effort: low | medium | high | xhigh | max (blank = model default)
ANTHROPIC_EFFORT=medium
# If a model's safety classifier declines, retry on Anthropic's recommended fallback model.
ANTHROPIC_REFUSAL_FALLBACK=true

# --- OpenAI (or Azure OpenAI / any OpenAI-compatible server via OPENAI_BASE_URL) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODELS=gpt-5,gpt-5-mini

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODELS=gemini-flash-latest,gemini-pro-latest

# --- Ollama (local models) ---
# Local install: http://localhost:11434   Docker compose "local" profile: http://ollama:11434
OLLAMA_BASE_URL=
OLLAMA_MODELS=llama3.2

# --- Mock provider (no key needed). Turn off in production. ---
# Models: mock/echo (echoes your message), mock/echo-system (replies with the system prompt it got)
ENABLE_MOCK_PROVIDER=true

# --- Database (Layer 2 prompts). Blank = prompt features off; chat still works. ---
# Local: postgresql+asyncpg://eap:eap@localhost:5432/eap  (docker compose sets this for you)
DATABASE_URL=

# --- Prompts (Layer 2) ---
# Prompt used when a chat request sends neither "prompt" nor "system". Blank = none.
DEFAULT_PROMPT_NAME=

# --- Knowledge bases / RAG (Layer 3). Needs DATABASE_URL on Postgres with pgvector. ---
# openai | gemini | ollama | mock. Blank = first configured, in that order.
EMBEDDING_PROVIDER=
# Blank = provider default: text-embedding-3-small / gemini-embedding-001 / nomic-embed-text.
# Must be able to return 768 numbers. Changing it means re-indexing collections.
EMBEDDING_MODEL=
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_CANDIDATES=20
RAG_MAX_UPLOAD_MB=20
RAG_INGEST_CONCURRENCY=2

# --- MCP tools (Layer 4). Needs DATABASE_URL (the server registry is stored there). ---
# Encrypts MCP secrets (stdio env values, HTTP headers) in the database. Needed only to save secrets.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))". Changing it makes saved secrets unreadable.
SECRET_KEY=
# Allow MCP servers that the backend starts as local commands (stdio). Set false to allow only HTTP servers.
MCP_ALLOW_STDIO=true
MCP_MAX_TOOL_ROUNDS=5
MCP_CALL_TIMEOUT_S=30
MCP_CONNECT_TIMEOUT_S=20
MCP_MAX_RESULT_CHARS=20000

# --- Auth: RBAC + OAuth (Layer 5) ---
# false = no sign-in: every request acts as a built-in dev user with DEV_USER_ROLES. Local development only.
AUTH_ENABLED=false
# The OIDC provider, exactly as in the tokens' "iss" (Keycloak: http://<host>:8080/realms/<realm>).
OIDC_ISSUER=http://localhost:8080/realms/eap
# Tokens must list this in "aud" (the eap-web client in infra/keycloak adds it).
OIDC_AUDIENCE=eap-api
# The public client the frontend signs in with (authorization code + PKCE).
OIDC_CLIENT_ID=eap-web
OIDC_SCOPE=openid profile email
# Where to read signing keys. Blank = discover from the issuer. Set it when the backend reaches the
# provider at another address, e.g. in Docker: http://keycloak:8080/realms/eap/protocol/openid-connect/certs
OIDC_JWKS_URL=
OIDC_JWKS_CACHE_S=600
# Roles of the dev user when AUTH_ENABLED=false (try eap-user to see a normal user's view).
DEV_USER_ROLES=eap-admin
# Limit models to roles, as JSON. Unlisted models are open to every role.
# MODEL_ROLES={"anthropic/claude-opus-5-5": ["eap-admin", "eap-editor"]}
MODEL_ROLES={}

# --- Guardrails (Layer 6). Policies are edited via /v1/guardrails (admins); built-in defaults otherwise. ---
GUARDRAILS_ENABLED=true
# Optional cheap model as a second opinion for injection / harmful / topic checks. Blank = rules only.
# GUARDRAIL_JUDGE_MODEL=anthropic/claude-haiku-5-5
GUARDRAIL_JUDGE_MODEL=
GUARDRAIL_JUDGE_TIMEOUT_S=10
# If the judge fails: true = treat as flagged (block), false = rules decide.
GUARDRAIL_FAIL_CLOSED=false
GUARDRAIL_CACHE_S=30
GUARDRAIL_MAX_SCAN_CHARS=100000
