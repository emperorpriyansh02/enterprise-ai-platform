{
  "realm": "eap",
  "displayName": "Enterprise AI Platform",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "eap-admin",
        "description": "Everything, including MCP server management"
      },
      {
        "name": "eap-editor",
        "description": "Change prompts and knowledge bases, plus everything a user can do"
      },
      {
        "name": "eap-user",
        "description": "Chat, read prompts and knowledge bases, use tools"
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "default-roles-eap",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "eap-user"
          ]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-eap",
    "description": "${role_default-roles}",
    "composite": true
  },
  "clients": [
    {
      "clientId": "eap-web",
      "name": "Enterprise AI Platform (web)",
      "description": "The Next.js frontend. Public client: authorization code flow with PKCE, no secret.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "http://localhost:3000",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://127.0.0.1:3000/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "eap-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "eap-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "alice-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-eap",
        "eap-admin"
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Editor",
      "credentials": [
        {
          "type": "password",
          "value": "bob-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-eap",
        "eap-editor"
      ]
    },
    {
      "username": "carol",
      "enabled": true,
      "email": "carol@example.com",
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "carol-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-eap",
        "eap-user"
      ]
    }
  ]
}
